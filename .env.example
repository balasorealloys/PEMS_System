# PEMS configuration — copy this file to ".env" and fill in the values.
# This is the ONLY file you edit to run PEMS. Nothing here is committed with real
# values; put your actual hosts/passwords in .env (which is never committed).

# ---- Primary database (PostgreSQL) — REQUIRED --------------------------------
# All pems_* application tables + the synced meter data live here (corpappdb,
# schema "pems"). Use the least-privilege role, NOT the DB superuser.
DB_DIALECT=postgresql+psycopg
DB_HOST=your-postgres-host          # host/IP, or localhost when using an SSH tunnel
DB_PORT=5432
DB_USER=pems_app
DB_PASS=your-pems_app-password
DB_NAME=corpappdb
DB_SCHEMA=pems

# ---- Auth database (MySQL) — REQUIRED ----------------------------------------
# Intranet single sign-on / session / page-view tables only (balcorpdb).
AUTH_DB_DIALECT=mysql+pymysql
AUTH_DB_HOST=your-mysql-host
AUTH_DB_PORT=3306
AUTH_DB_USER=your-db-user
AUTH_DB_PASS=your-db-password
AUTH_DB_NAME=balcorpdb

# ---- App — REQUIRED ----------------------------------------------------------
APP_ENV=prod
APP_PORT=4040                       # port PEMS serves on (UI + API together). Change if busy.
# One-time key that encrypts the saved SAP password. Generate ONCE, keep it stable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PEMS_SECRET_KEY=

# ---- Optional (sensible defaults; SAP can also be set from the app UI) --------
# SAP_ODATA_BASE=https://<sap-host>:44300/sap/opu/odata/sap
# SAP_ODATA_SERVICE=ZPM_POWER_CONSUMPTION_SRV
# CLIENT_ID=CI1001                  # BAL Balasore data scope — decides the em_valuedata_* table
# PLANT_ID=PI1001
